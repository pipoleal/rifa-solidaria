# Copie este arquivo para .env (nunca commitar o .env real)

# Usado a partir da Etapa 2 (Prisma)
DATABASE_URL=

# Usado a partir da Etapa 4 (criação de preferência no Mercado Pago) — use um
# Access Token de TESTE (sandbox), nunca o de produção, em desenvolvimento.
MP_ACCESS_TOKEN=

# Usado a partir da Etapa 6 (validação de assinatura do webhook via
# WebhookSignatureValidator do SDK oficial). Gerada em "Suas integrações →
# Webhooks → Configurar notificação" no painel do Mercado Pago.
MP_WEBHOOK_SECRET=

# Usados a partir da Etapa 3 (servidor Fastify + CORS)
FRONTEND_URL=http://localhost:3000
PORT=3333

# Usado a partir da Etapa 4 — URL pública do PRÓPRIO backend (não do frontend),
# usada para montar o notification_url enviado ao Mercado Pago. Em dev local,
# só precisa ser um túnel público de verdade quando formos testar o webhook (Etapa 6).
BACKEND_PUBLIC_URL=http://localhost:3333

NODE_ENV=development
