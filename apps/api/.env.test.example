# Copie para .env.test (gitignored) para rodar `npm run test:integration`.
# Requer `docker compose -f docker-compose.test.yml up -d` rodando (ou
# qualquer outro Postgres de teste descartável apontado aqui).

DATABASE_URL="postgresql://test:test@localhost:55432/solidaria_test"

# Placeholders — os testes de integração mockam o client do Mercado Pago
# (lib/mercadopago.ts) da mesma forma que os testes normais; estas variáveis
# só precisam existir para o app subir (ver lib/mercadopago.ts, lib/prisma.ts).
MP_ACCESS_TOKEN=TEST-integration-placeholder
MP_WEBHOOK_SECRET=integration-test-secret

FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3333
PORT=3333
NODE_ENV=test
